# Bud Transcriptomic Data Analysis
#
# Differential gene expression, WGCNA, and pathway enrichment analysis of
# grapevine bud transcriptomes in response to simulated warming treatments
# (Before Leaf Fall [BLF], After Leaf Fall [ALF], BOTH, Control).

#############################################################################

## ---- Packages ----
# BiocManager::install(c("DESeq2", "WGCNA", "preprocessCore", "fgsea"))
# install.packages(c("tidyverse", "ggpubr", "wesanderson", "Rmisc",
#                     "factoextra", "scales", "patchwork", "cowplot",
#                     "viridis", "VennDiagram"))

library(DESeq2)
library(WGCNA)
library(fgsea)
library(tidyverse)
library(ggplot2)
library(ggpubr)
library(wesanderson)
library(Rmisc)
library(factoextra)
library(scales)
library(viridis)
library(patchwork)
