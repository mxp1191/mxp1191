## 6. Differential expression analysis: each treatment vs Control
##    within each warming period (DESeq2 contrasts)
#############################################################################

coldata2 <- coldata
coldata2$Gen_Time_and_treatment <- paste0(coldata2$Time, coldata2$TRT)

dds_contrast <- DESeqDataSetFromMatrix(countData = cts, colData = coldata2,
                                       design = ~ Gen_Time_and_treatment)
keep <- rowSums(counts(dds_contrast)) >= ncol(cts)
dds_contrast <- dds_contrast[keep, ]
dds_contrast_out <- DESeq(dds_contrast)

extract_DEGs <- function(dds_out, contrast_vec, lfc_threshold = 1, padj_threshold = 0.05) {
  res <- results(dds_out, contrast = contrast_vec)
  print(summary(res))
  res_df <- as.data.frame(res)
  res_target <- filter(res_df, padj < padj_threshold, abs(log2FoldChange) > lfc_threshold)
  res_target$gene_id <- row.names(res_target)
  list(all = res_df, sig = res_target)
}

# September warming period (timepoint "DE"): BLF vs Control, BOTH vs Control
res_BLF_C_Sept  <- extract_DEGs(dds_contrast_out, c("Gen_Time_and_treatment", "DEE",  "DEC"))
res_BOTH_C_Sept <- extract_DEGs(dds_contrast_out, c("Gen_Time_and_treatment", "DEEL", "DEC"))

# December warming period (timepoint "DL"): ALF vs Control, BOTH vs Control
res_ALF_C_Dec   <- extract_DEGs(dds_contrast_out, c("Gen_Time_and_treatment", "DLL",  "DLC"))
res_BOTH_C_Dec  <- extract_DEGs(dds_contrast_out, c("Gen_Time_and_treatment", "DLEL", "DLC"))

#############################################################################
## 7. Functional annotation and pathway overrepresentation analysis (ORA)
##    fgsea::fora() against VitisNet pathway gene sets
#############################################################################

# `gene_id_map`     : table mapping pipeline gene IDs to annotated (V1) gene IDs
# `Gene_function`    : table of functional annotation / VitisNet pathway per gene
gene_id_map   <- read.delim("gene_id_correspondence.txt", header = TRUE)
Gene_function <- read.delim("VitisNet_gene_function.txt", header = TRUE)
vitis_pathway <- gmtPathways("GSEA_geneset_from_VitisNet.gmt")

annotate_DEGs <- function(res_target) {
  res_target$v1_gene_id <- gene_id_map$v1.name[match(res_target$gene_id,
                                                     gene_id_map$Final.v3.name..tentative.creation.of.new.genes)]
  res_target$encoding_protein <- Gene_function$Functional.annotation[match(res_target$v1_gene_id,
                                                                           Gene_function$Unique.ID)]
  res_target$pathway <- Gene_function$Network[match(res_target$v1_gene_id, Gene_function$Unique.ID)]
  filter(res_target, !is.na(pathway), pathway != "")
}

run_ORA <- function(res_all, res_target_annotated) {
  universe <- gene_id_map$v1.name[match(row.names(res_all),
                                        gene_id_map$Final.v3.name..tentative.creation.of.new.genes)]
  universe <- universe[!is.na(universe) & universe != ""]
  fora(pathways = vitis_pathway, genes = res_target_annotated$v1_gene_id,
       minSize = 2, maxSize = 500, universe = universe)
}

# --- BLF vs Control (September) ---
res_BLF_C_Sept$sig_annot <- annotate_DEGs(res_BLF_C_Sept$sig)
ORA_BLF_Sept <- run_ORA(res_BLF_C_Sept$all, res_BLF_C_Sept$sig_annot)
ORA_BLF_Sept_sig <- filter(ORA_BLF_Sept, padj < 0.05) %>%
