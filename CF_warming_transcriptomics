#############################################################################
# Bud Transcriptomic Data Analysis
#
# DESeq2, WGCNA, and pathway enrichment analysis of grapevine bud
# transcriptomes in response to simulated warming treatments
# (BLF = Before Leaf Fall, ALF = After Leaf Fall, BOTH (BLF + ALF), Control).
# Sometimes BLF is labeled "Early" and ALF is labeled "Late" in code.
#############################################################################

library(WGCNA)
library(fgsea)
library(devtools)
library(tidyverse)
library(ggplot2)
library(DESeq2)
library(ggpubr)
library(tidyr)
library(dplyr)
library(wesanderson)
library(Rmisc)
library(factoextra)
library(scales)
library(patchwork)
library(cowplot)

#############################################################################
## 1. Import and merge count matrices / sample metadata
#############################################################################

matrixFile1 <- read.delim("Gene_count_matrix_extraction_1.txt", header = F, row.names = 1)
sampleFile1 <- read.csv("MetadatEx1.csv")

matrixFile2 <- read.delim("Gene_count_matrix_extraction_2.txt", header = F, row.names = 1)
sampleFile2 <- read.csv("MetadatEx2.csv")
sampleFile2 = sampleFile2[,-c(11,12)]

matrixFile = cbind(matrixFile1, matrixFile2)
sampleFile = rbind(sampleFile1, sampleFile2)

coldata = sampleFile
cts = matrixFile
colnames(cts) = coldata$Sample
row.names(coldata) = coldata$Sample

cts = cts[,colnames(cts) %in% row.names(coldata)]
coldata <- filter(coldata, Time != 'BLANK')
cts <- cts[,c(row.names(coldata))]

# Raw read count summary
total_raw_reads_per_sample <- colSums(cts)
mean_raw_reads <- mean(total_raw_reads_per_sample)
sd_raw_reads <- sd(total_raw_reads_per_sample)
detected_genes_before <- sum(rowSums(cts) > 0)

cat("=== Before filtering ===\n")
cat("Average raw reads per sample:", format(mean_raw_reads, big.mark = ","), "\n")
cat("Standard deviation:", format(sd_raw_reads, big.mark = ","), "\n")
cat("Detected genes before filtering:", detected_genes_before, "\n")

#############################################################################
## 2. Normalize counts and filter low-expression genes (DESeq2)
#############################################################################

dds <- DESeqDataSetFromMatrix(countData = cts, colData = coldata, design = ~ TimeNum + TRT)
keep <- rowSums(counts(dds)) >= ncol(cts) * 5
dds <- dds[keep,]

dds_out <- DESeq(dds)
dds_out_normalized <- data.frame(counts(dds_out, normalized = TRUE))
vsd <- vst(dds_out, blind = FALSE)
cts_normalized <- as.data.frame(assay(vsd))

#############################################################################
## 3. PCA-based outlier detection and removal
#############################################################################

PCA_All_DEGs <- prcomp(t(cts_normalized), scale = TRUE)
eig.val_PCA_All_DEGs <- get_eigenvalue(PCA_All_DEGs)
res_idv_PCA_All_DEGs <- get_pca_ind(PCA_All_DEGs)
PCA_All_DEGs_figure_data <- data.frame(
  filter(coldata, row.names(coldata) %in% colnames(cts_normalized)),
  res_idv_PCA_All_DEGs$coord[,1:4]
)
percentVar_PCA_All_DEGs <- round(eig.val_PCA_All_DEGs$variance.percent, 1)

PCA_All_DEGs_figure_1 <- ggplot(PCA_All_DEGs_figure_data, aes(x = Dim.1, y = Dim.2, col = TimeNum)) +
  geom_point() +
  facet_wrap(~TRT) +
  xlab(paste0("PC1: ", percentVar_PCA_All_DEGs[1], "% variance")) +
  ylab(paste0("PC2: ", percentVar_PCA_All_DEGs[2], "% variance")) +
  theme_bw() +
  scale_colour_manual(values = c('#046C9A', wes_palette("Zissou1", 5, type = "continuous"), '#9B110E')) +
  theme(axis.line = element_line(colour = "black")) +
  theme(axis.title = element_text(color = "black", size = 14, face = "bold")) +
  theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank()) +
  theme(legend.direction = "vertical", legend.box = "vertical") +
  theme(axis.text = element_text(color = "black", size = 9)) +
  theme(legend.text = element_text(color = "Black", size = 12, face = "bold")) +
  theme(legend.title = element_text(color = "Black", size = 12, face = "bold"))

ggsave("PreFilterPCA.png", plot = PCA_All_DEGs_figure_1, width = 15, height = 11, dpi = 700)

# Remove outlier samples identified on PC2
further_exclude_PCA <- row.names(filter(PCA_All_DEGs_figure_data, Dim.2 < -200))
coldata <- filter(coldata, !row.names(coldata) %in% further_exclude_PCA)
cts <- cts[,colnames(cts) %in% row.names(coldata)]
all(rownames(coldata) == colnames(cts))

# Re-run DESeq2 normalization after outlier removal
dds <- DESeqDataSetFromMatrix(countData = cts, colData = coldata, design = ~ TimeNum + TRT)
keep <- rowSums(counts(dds)) >= ncol(cts) * 5
dds <- dds[keep,]
dds_out <- DESeq(dds)

dds_out_normalized <- data.frame(counts(dds_out, normalized = TRUE))
vsd <- vst(dds_out, blind = FALSE)
cts_normalized <- as.data.frame(assay(vsd))

PCA_All_DEGs <- prcomp(t(cts_normalized), scale = TRUE)
eig.val_PCA_All_DEGs <- get_eigenvalue(PCA_All_DEGs)
res_idv_PCA_All_DEGs <- get_pca_ind(PCA_All_DEGs)
PCA_All_DEGs_figure_data <- data.frame(
  filter(coldata, row.names(coldata) %in% colnames(cts_normalized)),
  res_idv_PCA_All_DEGs$coord[,1:4]
)
percentVar_PCA_All_DEGs <- round(eig.val_PCA_All_DEGs$variance.percent, 1)

PCA_All_DEGs_figure_data$TRT <- factor(PCA_All_DEGs_figure_data$TRT, levels = c("C", "E", "L", "EL"),
                                       labels = c("Control", "BLF", "ALF", "BOTH"))
PCA_All_DEGs_figure_data$TimeNum <- factor(PCA_All_DEGs_figure_data$TimeNum, levels = c(1, 2, 3, 4, 5, 6, 7),
                                           labels = c("September 3, 2021", "September 14, 2021", "October 19, 2021",
                                                      "November 29, 2021", "December 8, 2021", "December 20, 2021", "January 13, 2022"))

PCA_All_DEGs_figure_1nowrap <- ggplot(PCA_All_DEGs_figure_data, aes(x = Dim.1, y = Dim.2, col = TimeNum, shape = TRT)) +
  geom_point(size = 5) +
  xlab(paste0("PC1: ", percentVar_PCA_All_DEGs[1], "% variance")) +
  ylab(paste0("PC2: ", percentVar_PCA_All_DEGs[2], "% variance")) +
  ggtitle("Principal Component Analysis of bud gene expression") +
  theme_bw() +
  scale_colour_manual(values = c('#046C9A', wes_palette("Zissou1", 5, type = "continuous"), '#9B110E')) +
  scale_shape_manual(values = c(15, 16, 17, 18)) +
  theme(axis.line = element_line(colour = "black"),
        axis.title = element_text(color = "black", size = 14, face = "bold"),
        panel.grid.major = element_blank(),
        panel.grid.minor = element_blank(),
        legend.direction = "vertical",
        legend.box = "vertical",
        axis.text = element_text(color = "black", size = 9),
        legend.text = element_text(color = "Black", size = 14, face = "bold"),
        legend.title = element_text(color = "Black", size = 14, face = "bold")) +
  labs(col = "Timepoint", shape = "Treatment")

ggsave("PCA_figure.png", plot = PCA_All_DEGs_figure_1nowrap, width = 10, height = 8, unit = "in", dpi = 700)

#############################################################################
## 4. WGCNA: module detection
#############################################################################

datExpr0 = as.data.frame(t(cts_normalized))
datExpr = datExpr0
nGenes = ncol(datExpr)
nSamples = nrow(datExpr)
options(stringsAsFactors = FALSE)

allTraits = coldata
filtered_samples <- row.names(datExpr)
datTraits <- filter(allTraits, row.names(allTraits) %in% filtered_samples)
row.names(datTraits) = filtered_samples

# Soft-thresholding power selection
powers = c(c(1:10), seq(from = 12, to = 20, by = 2))
sft = pickSoftThreshold(datExpr, powerVector = powers, verbose = 5)

plot(sft$fitIndices[,1], -sign(sft$fitIndices[,3]) * sft$fitIndices[,2],
     xlab = "Soft Threshold (power)", ylab = "Scale Free Topology Model Fit, signed R^2",
     main = "Scale independence")
text(sft$fitIndices[,1], -sign(sft$fitIndices[,3]) * sft$fitIndices[,2], labels = powers, col = "red")
abline(h = 0.90, col = "red")

plot(sft$fitIndices[,1], sft$fitIndices[,5],
     xlab = "Soft Threshold (power)", ylab = "Mean Connectivity", main = "Mean connectivity")
text(sft$fitIndices[,1], sft$fitIndices[,5], labels = powers, col = "red")

# Network construction and module detection
cor <- WGCNA::cor
net = blockwiseModules(datExpr, power = 12, networkType = "signed",
                       TOMType = "signed", minModuleSize = 50,
                       reassignThreshold = 0, mergeCutHeight = 0.25,
                       numericLabels = TRUE, pamRespectsDendro = FALSE,
                       saveTOMs = TRUE, saveTOMFileBase = "supervised_norm_count_TOM",
                       verbose = 3)
cor <- stats::cor

moduleLabels = net$colors
moduleColors = labels2colors(net$colors)
MEs0 = moduleEigengenes(datExpr, moduleColors)$eigengenes
MEs = orderMEs(MEs0)
geneTree = net$dendrograms[[1]]

save(MEs, moduleLabels, moduleColors, geneTree, file = "networkConstruction.RData")

N_gene_per_module <- as.data.frame(table(moduleColors))
names(N_gene_per_module) = c("module_name", "Gene_number")
N_gene_per_module <- N_gene_per_module[order(-N_gene_per_module$Gene_number),]
N_gene_per_module$name_and_number <- paste0("ME", N_gene_per_module$module_name, " (", N_gene_per_module$Gene_number, ")")

# Module membership
geneModuleMembership = as.data.frame(cor(datExpr, MEs, use = "p"))
MMpval = as.data.frame(corPvalueStudent(as.matrix(geneModuleMembership), nSamples))
modNames = substring(names(MEs), 3)
names(geneModuleMembership) = modNames
names(MMpval) = modNames
geneModuleMembership$final_module = moduleColors
MMpval$final_module = moduleColors
geneModuleMembership$gene_name = row.names(geneModuleMembership)
MMpval$gene_name = row.names(MMpval)

gmm_long = gather(geneModuleMembership, key = 'module', value = 'MM', modNames[1]:modNames[length(modNames)])
MMpval_long = gather(MMpval, key = 'module', value = 'MMpval', modNames[1]:modNames[length(modNames)])
colnames(gmm_long)[1] = 'gene_name'
colnames(MMpval_long)[1] = 'gene_name'
gmm_MMpval_long = data.frame(gmm_long, MMpval = MMpval_long$MMpval)

#############################################################################
## 5. Module eigengene visualization over time
#############################################################################

sample_name <- row.names(datTraits)
MEs_visualization <- data.frame(sample_name, MEs, datTraits)
MEs_visualization$SDATE <- as.Date(MEs_visualization$SDATE, format = "%m/%d/%Y")

MEs_visualization_long <- gather(MEs_visualization, Module, ME, MEdarkgreen:MEgrey, factor_key = TRUE)
MEs_visualization_long_summary2 <- summarySE(MEs_visualization_long, measurevar = "ME", groupvars = c('Module', "SDATE", "TRT"))

pd <- position_dodge(0.2)
module_levels = paste0("ME", N_gene_per_module$module_name)
MEs_visualization_long_summary2$Module <- factor(MEs_visualization_long_summary2$Module, levels = module_levels,
                                                 labels = N_gene_per_module$name_and_number)
MEs_visualization_long_summary2$TRT <- factor(MEs_visualization_long_summary2$TRT,
                                              levels = c("C", "E", "L", "EL"),
                                              labels = c("Control", "BLF", "ALF", "BOTH"))

custom_colors <- viridis::viridis(4, option = "D")

# Largest modules (Turquoise and Blue)
Bselect <- MEs_visualization_long_summary2[grepl("2799|4443", MEs_visualization_long_summary2$Module),]

eigengene_plot_TurqBlue <- ggplot(Bselect, aes(x = SDATE, y = ME, group = TRT, color = TRT, shape = TRT)) +
  geom_errorbar(aes(ymin = ME - se, ymax = ME + se), width = 0.2) +
  geom_line(position = pd, linewidth = 1.2) +
  geom_point(position = pd, size = 5) +
  facet_wrap(~Module, ncol = 2, scales = "fixed",
             labeller = labeller(Module = c("MEturquoise (4443)" = "Module 1 (4,443 genes)", "MEblue (2799)" = "Module 2 (2,799 genes)"))) +
  scale_color_manual(values = custom_colors) +
  scale_shape_manual(values = c(16, 17, 18, 19)) +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 45, vjust = 0.65),
    legend.position = "top", legend.title = element_blank(),
    panel.grid = element_blank(), strip.background = element_blank()
  ) +
  scale_x_date(date_labels = "%m-%d") +
  labs(x = "Date", y = "Module Eigengene (ME)")

ggsave("ME_TurquoiseBlue.png", plot = eigengene_plot_TurqBlue, width = 12, height = 7, dpi = 700)

# Smaller treatment-responsive modules (Magenta, Purple)
EandLselect <- MEs_visualization_long_summary2[grepl("363|297", MEs_visualization_long_summary2$Module),]

eigengene_plot_MagentaPurple <- ggplot(EandLselect, aes(x = SDATE, y = ME, group = TRT, color = TRT, shape = TRT)) +
  geom_errorbar(aes(ymin = ME - se, ymax = ME + se), width = 0.2) +
  geom_line(position = pd, linewidth = 1.2) +
  geom_point(position = pd, size = 5) +
  facet_wrap(~Module, ncol = 2, scales = "fixed",
             labeller = labeller(Module = c("MEmagenta (363)" = "Module 3 (363 genes)", "MEpurple (297)" = "Module 4 (297 genes)"))) +
  scale_color_manual(values = custom_colors) +
  scale_shape_manual(values = c(16, 17, 18, 19)) +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 45, vjust = 0.65),
    legend.position = "top", legend.title = element_blank(),
    panel.grid = element_blank(), strip.background = element_blank()
  ) +
  scale_x_date(date_labels = "%m-%d") +
  labs(x = "Date", y = "Module Eigengene (ME)")

ggsave("ME_MagentaPurple.png", plot = eigengene_plot_MagentaPurple, width = 12, height = 7, dpi = 700)

#############################################################################
