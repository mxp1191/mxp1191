# Generic helper: bar plot of representative DEGs from a given pathway,
# contrasting one warming treatment vs Control at the relevant timepoint
plot_pathway_genes <- function(gene_ids, timepoint, trt_levels, trt_labels, fill_colors, y_limit) {
  df <- filter(gene_expr_summary, v1_gene_id %in% gene_ids, Time == timepoint, TRT %in% trt_levels)
  df$subtitle <- paste0(df$gene_id, "\n", df$encoding_protein)
  df$TRT <- factor(df$TRT, levels = trt_levels, labels = trt_labels)
  
  ggplot(df, aes(x = TRT, y = Expression, fill = TRT)) +
    geom_bar(stat = "identity", position = "dodge", color = "black") +
    geom_errorbar(aes(ymin = Expression - se, ymax = Expression + se), width = 0.2) +
    facet_wrap(~subtitle, ncol = 4, scales = "fixed") +
    scale_fill_manual(values = fill_colors) +
    theme_bw() +
    labs(x = NULL, y = "Normalized gene expression") +
    theme(panel.grid = element_blank(), legend.position = "none",
          strip.background = element_blank()) +
    scale_y_continuous(limits = c(0, y_limit), expand = c(0, 0))
}

