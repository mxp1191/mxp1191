# NOTE: WGCNA's `cor()` can mask base/stats::cor() and break DESeq2 calls.
# Resolve conflicts as needed, e.g.:
#   cor <- WGCNA::cor()      # before blockwiseModules()
#   cor <- stats::cor()      # after blockwiseModules()

#############################################################################
## 1. Import and merge count matrices / sample metadata
#############################################################################

matrixFile1 <- read.delim("Gene_count_matrix_extraction_1.txt", header = FALSE, row.names = 1)
sampleFile1 <- read.csv("MetadatEx1.csv")

matrixFile2 <- read.delim("Gene_count_matrix_extraction_2.txt", header = FALSE, row.names = 1)
sampleFile2 <- read.csv("MetadatEx2.csv")

# Ensure both metadata tables share the same columns before merging
stopifnot(identical(colnames(sampleFile1), colnames(sampleFile2)))

matrixFile <- cbind(matrixFile1, matrixFile2)
sampleFile <- rbind(sampleFile1, sampleFile2)

coldata <- sampleFile
cts <- matrixFile
colnames(cts) <- coldata$Sample
row.names(coldata) <- coldata$Sample

cts <- cts[, colnames(cts) %in% row.names(coldata)]
coldata <- filter(coldata, Time != "BLANK")
cts <- cts[, row.names(coldata)]

#############################################################################
## 2. Normalize counts and filter low-expression genes (DESeq2)
#############################################################################

dds <- DESeqDataSetFromMatrix(countData = cts, colData = coldata, design = ~ TimeNum + TRT)

# Retain genes with at least 5 counts/sample on average
keep <- rowSums(counts(dds)) >= ncol(cts) * 5
dds <- dds[keep, ]

dds_out <- DESeq(dds)
vsd <- vst(dds_out, blind = FALSE)
cts_normalized <- as.data.frame(assay(vsd))

#############################################################################
## 3. PCA-based outlier detection and removal
#############################################################################

PCA_All <- prcomp(t(cts_normalized), scale = TRUE)
eig.val <- get_eigenvalue(PCA_All)
res_idv <- get_pca_ind(PCA_All)
PCA_figure_data <- data.frame(
  filter(coldata, row.names(coldata) %in% colnames(cts_normalized)),
  res_idv$coord[, 1:4]
)
percentVar <- round(eig.val$variance.percent, 1)

ggplot(PCA_figure_data, aes(x = Dim.1, y = Dim.2, col = TimeNum)) +
  geom_point() +
  facet_wrap(~TRT) +
  xlab(paste0("PC1: ", percentVar[1], "% variance")) +
  ylab(paste0("PC2: ", percentVar[2], "% variance")) +
  theme_bw() +
  scale_colour_manual(values = c("#046C9A", wes_palette("Zissou1", 5, type = "continuous"), "#9B110E"))

ggsave("PreFilterPCA.png", width = 15, height = 11, dpi = 700)

# Remove outlier sample(s) identified on PC2 (one BOTH-treatment replicate)
outliers <- row.names(filter(PCA_figure_data, Dim.2 < -200))
coldata <- filter(coldata, !row.names(coldata) %in% outliers)
cts <- cts[, colnames(cts) %in% row.names(coldata)]
stopifnot(all(rownames(coldata) == colnames(cts)))

# Re-run DESeq2 normalization after outlier removal
dds <- DESeqDataSetFromMatrix(countData = cts, colData = coldata, design = ~ TimeNum + TRT)
keep <- rowSums(counts(dds)) >= ncol(cts) * 5
dds <- dds[keep, ]
dds_out <- DESeq(dds)

dds_out_normalized <- data.frame(counts(dds_out, normalized = TRUE))
vsd <- vst(dds_out, blind = FALSE)
cts_normalized <- as.data.frame(assay(vsd))

# Final PCA (post-outlier removal)
PCA_All <- prcomp(t(cts_normalized), scale = TRUE)
eig.val <- get_eigenvalue(PCA_All)
res_idv <- get_pca_ind(PCA_All)
PCA_figure_data <- data.frame(
  filter(coldata, row.names(coldata) %in% colnames(cts_normalized)),
  res_idv$coord[, 1:4]
)
percentVar <- round(eig.val$variance.percent, 1)

PCA_figure_data$TRT <- factor(PCA_figure_data$TRT,
                              levels = c("C", "E", "L", "EL"),
                              labels = c("Control", "BLF", "ALF", "BOTH"))

ggplot(PCA_figure_data, aes(x = Dim.1, y = Dim.2, col = TimeNum, shape = TRT)) +
  geom_point(size = 5) +
  xlab(paste0("PC1: ", percentVar[1], "% variance")) +
  ylab(paste0("PC2: ", percentVar[2], "% variance")) +
  ggtitle("Principal Component Analysis of bud gene expression") +
  theme_bw() +
  scale_colour_manual(values = c("#046C9A", wes_palette("Zissou1", 5, type = "continuous"), "#9B110E")) +
  scale_shape_manual(values = c(15, 16, 17, 18)) +
  labs(col = "Timepoint", shape = "Treatment")

ggsave("PCA_figure.png", width = 10, height = 8, dpi = 700)

#############################################################################
## 4. WGCNA: module detection
#############################################################################

datExpr <- as.data.frame(t(cts_normalized))
nGenes <- ncol(datExpr)
nSamples <- nrow(datExpr)
options(stringsAsFactors = FALSE)

datTraits <- filter(coldata, row.names(coldata) %in% row.names(datExpr))
row.names(datTraits) <- row.names(datExpr)

# Soft-thresholding power selection
powers <- c(1:10, seq(12, 20, by = 2))
sft <- pickSoftThreshold(datExpr, powerVector = powers, verbose = 5)

plot(sft$fitIndices[, 1], -sign(sft$fitIndices[, 3]) * sft$fitIndices[, 2],
     xlab = "Soft Threshold (power)", ylab = "Scale Free Topology Model Fit, signed R^2",
     main = "Scale independence")
text(sft$fitIndices[, 1], -sign(sft$fitIndices[, 3]) * sft$fitIndices[, 2],
     labels = powers, col = "red")
abline(h = 0.90, col = "red")

plot(sft$fitIndices[, 1], sft$fitIndices[, 5],
     xlab = "Soft Threshold (power)", ylab = "Mean Connectivity",
     main = "Mean connectivity")
text(sft$fitIndices[, 1], sft$fitIndices[, 5], labels = powers, col = "red")

# Network construction and module detection
cor <- WGCNA::cor
net <- blockwiseModules(datExpr, power = 12, networkType = "signed",
                        TOMType = "signed", minModuleSize = 50,
                        reassignThreshold = 0, mergeCutHeight = 0.25,
                        numericLabels = TRUE, pamRespectsDendro = FALSE,
                        saveTOMs = TRUE, saveTOMFileBase = "TOM",
                        verbose = 3)
cor <- stats::cor

moduleLabels <- net$colors
moduleColors <- labels2colors(net$colors)
MEs0 <- moduleEigengenes(datExpr, moduleColors)$eigengenes
MEs <- orderMEs(MEs0)
geneTree <- net$dendrograms[[1]]

save(MEs, moduleLabels, moduleColors, geneTree, file = "WGCNA-networkConstruction.RData")

N_gene_per_module <- as.data.frame(table(moduleColors))
names(N_gene_per_module) <- c("module_name", "Gene_number")
N_gene_per_module <- N_gene_per_module[order(-N_gene_per_module$Gene_number), ]
N_gene_per_module$name_and_number <- paste0("ME", N_gene_per_module$module_name,
                                            " (", N_gene_per_module$Gene_number, ")")

# Module membership (correlation of each gene with each module eigengene)
geneModuleMembership <- as.data.frame(cor(datExpr, MEs, use = "p"))
MMpval <- as.data.frame(corPvalueStudent(as.matrix(geneModuleMembership), nSamples))
modNames <- substring(names(MEs), 3)
names(geneModuleMembership) <- modNames
names(MMpval) <- modNames
geneModuleMembership$final_module <- moduleColors
MMpval$final_module <- moduleColors
geneModuleMembership$gene_name <- row.names(geneModuleMembership)
MMpval$gene_name <- row.names(MMpval)

