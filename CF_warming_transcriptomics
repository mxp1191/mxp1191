plot_pathway_barchart <- function(path_df, title, custom_labels = NULL) {
  path_df$pathway <- factor(path_df$pathway, levels = path_df$pathway[order(-path_df$poverlap)])
  p <- ggplot(path_df, aes(x = poverlap, y = fct_rev(pathway), fill = padj)) +
    geom_bar(stat = "identity", color = "black") +
    scale_fill_gradient(low = "#7876B1FF", high = "#6F99ADFF",
                        limits = c(0, 0.05), breaks = c(0.01, 0.05)) +
    labs(x = "Percent of total pathway enriched (%)", title = title,
         fill = expression(bold(p[adj]))) +
    theme_classic() +
    theme(axis.title.y = element_blank(),
          axis.text.y = element_text(size = 12, face = "bold")) +
    scale_x_continuous(expand = c(0, 0), limits = c(0, 30))
  if (!is.null(custom_labels)) p <- p + scale_y_discrete(labels = custom_labels)
  p
}

barchart_BLF  <- plot_pathway_barchart(ORA_BLF_Sept_sig, "During BLF (September) Warming")
barchart_ALF  <- plot_pathway_barchart(ORA_ALF_Dec_sig,  "During ALF (December) Warming")

