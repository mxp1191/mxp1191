gene_matrix_expression_long$pathway = Gene_function$Network[match(gene_matrix_expression_long$V1_name, Gene_function$Unique.ID)]

gene_matrix_expression_long_summary <- summarySE(gene_matrix_expression_long,
                                                 measurevar = "Expression", groupvars = c("V1_name", "Time", "TRT", "gene_name"))
gene_matrix_expression_long_summary$encoding_protein = Gene_function$Functional.annotation[match(gene_matrix_expression_long_summary$V1_name, Gene_function$Unique.ID)]
gene_matrix_expression_long_summary$pathway = Gene_function$Network[match(gene_matrix_expression_long_summary$V1_name, Gene_function$Unique.ID)]

#############################################################################
## 13. Shared genes bar graph (colored facets, non-pooled C vs E x C vs L)
#############################################################################

select_shared <- subset(gene_matrix_expression_long_summary, gene_name %in% shared_genes)

time_mapping <- c(
  PE = "2021-09-03",
  DE = "2021-09-14",
  AE = "2021-10-19",
  PL = "2021-11-29",
  DL = "2021-12-07",
  AL1 = "2021-12-20",
  AL2 = "2022-01-13"
)

select_shared$Date <- as.Date(time_mapping[select_shared$Time])
select_shared$Date_label <- format(select_shared$Date, "%b %d")

date_levels <- select_shared %>%
  distinct(Date, Date_label) %>%
  arrange(Date) %>%
  pull(Date_label)
select_shared$Date_label <- factor(select_shared$Date_label, levels = date_levels)

select_shared$subtitle <- paste0(select_shared$gene_name, "\n", select_shared$encoding_protein)

# Identify consistent vs flip-flop genes (C vs E at DE, C vs L at DL)
DE_genes <- select_shared %>%
  filter(Time == "DE", TRT %in% c("C", "E")) %>%
  select(gene_name, TRT, Expression) %>%
  pivot_wider(names_from = TRT, values_from = Expression) %>%
  mutate(up_in_BLF = E > C, down_in_BLF = E < C)

DL_genes <- select_shared %>%
  filter(Time == "DL", TRT %in% c("C", "L")) %>%
  select(gene_name, TRT, Expression) %>%
  pivot_wider(names_from = TRT, values_from = Expression) %>%
  mutate(up_in_ALF = L > C, down_in_ALF = L < C)

comparison <- DL_genes %>%
  select(gene_name, up_in_ALF, down_in_ALF) %>%
  left_join(DE_genes %>% select(gene_name, up_in_BLF, down_in_BLF), by = "gene_name") %>%
  mutate(
    direction_consistent = (up_in_ALF & up_in_BLF) | (down_in_ALF & down_in_BLF),
    direction_flipflop = !direction_consistent
  )

genes_upup     <- comparison %>% filter(up_in_ALF & up_in_BLF) %>% pull(gene_name)
genes_downdown <- comparison %>% filter(down_in_ALF & down_in_BLF) %>% pull(gene_name)
genes_flipflop <- comparison %>% filter(direction_flipflop) %>% pull(gene_name)

select_shared <- select_shared %>%
  mutate(
    subgroup = case_when(
      gene_name %in% genes_upup     ~ "Up_Up",
      gene_name %in% genes_downdown ~ "Down_Down",
      gene_name %in% genes_flipflop ~ "FlipFlop"
    )
  )

subgroup_levels <- c("Up_Up", "Down_Down", "FlipFlop")

gene_order_custom <- select_shared %>%
  distinct(gene_name, subgroup, pathway) %>%
  mutate(subgroup = factor(subgroup, levels = subgroup_levels)) %>%
  arrange(subgroup, pathway, gene_name) %>%
  pull(gene_name)

select_shared <- select_shared %>%
  mutate(gene_name_ordered = factor(gene_name, levels = gene_order_custom))

wrap_width <- 31
gene_labels <- select_shared %>%
  distinct(gene_name, encoding_protein) %>%
  arrange(match(gene_name, gene_order_custom)) %>%
  mutate(facet_label = paste0(gene_name, "\n", str_wrap(encoding_protein, width = wrap_width)))

select_shared <- select_shared %>%
  left_join(gene_labels %>% select(gene_name, facet_label), by = "gene_name")

facet_label_map_df <- select_shared %>%
  distinct(gene_name_ordered, facet_label) %>%
  arrange(match(as.character(gene_name_ordered), gene_order_custom))
facet_label_map <- setNames(facet_label_map_df$facet_label, as.character(facet_label_map_df$gene_name_ordered))

subgroup_colors <- c("Up_Up" = "#8B8878", "Down_Down" = "black", "FlipFlop" = "#FFFFFF")

strip_df <- select_shared %>%
  distinct(gene_name_ordered, subgroup) %>%
  mutate(xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf, fill_strip = subgroup_colors[subgroup])

de_x <- which(levels(select_shared$Date_label) == "Sep 14")
dl_x <- which(levels(select_shared$Date_label) == "Dec 07")

select_shared$Treatment <- factor(select_shared$TRT,
                                  levels = c("C", "E", "L", "EL"),
                                  labels = c("Control", "BLF", "ALF", "BOTH"))

shared_genes_barplot <- ggplot(select_shared, aes(x = factor(Date_label), y = Expression, fill = Treatment)) +
  geom_rect(data = strip_df, aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax),
            fill = strip_df$fill_strip, inherit.aes = FALSE, alpha = 0.6) +
  geom_col(position = position_dodge(0.9), width = 0.8, color = "black") +
  geom_errorbar(aes(ymin = Expression - se, ymax = Expression + se), width = 0.3, position = position_dodge(0.9)) +
  annotate("rect", xmin = de_x - 0.5, xmax = de_x + 0.5, ymin = -Inf, ymax = Inf, alpha = 0.3, fill = "#333533") +
  annotate("rect", xmin = dl_x - 0.5, xmax = dl_x + 0.5, ymin = -Inf, ymax = Inf, alpha = 0.3, fill = "#333533") +
  scale_fill_manual(values = c("Control" = "#440154FF", "BLF" = "#31688EFF", "ALF" = "#35B779FF", "BOTH" = "#FDE725FF")) +
  labs(x = NULL, y = "Normalized gene expression", fill = NULL) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.15))) +
  facet_wrap(~gene_name_ordered, scales = "free_y", nrow = 5,
             labeller = labeller(gene_name_ordered = facet_label_map)) +
  theme_bw() +
  theme(
    panel.grid = element_blank(),
    legend.position = "top",
    legend.text = element_text(size = 16),
    axis.text.x = element_text(angle = 0, hjust = 0.5, size = 13),
    axis.text.y = element_text(size = 14),
    axis.title.y = element_text(size = 16),
    strip.text = element_text(size = 14),
    strip.background = element_blank()
  )

ggsave("SharedGenes_CvsE_CvsL_Facett_Separated_Color.png", plot = shared_genes_barplot,
       width = 20, height = 12, dpi = 700)
