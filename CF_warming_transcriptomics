coldata2$Gen_Time_and_treatment = paste0(coldata2$Time, coldata2$TRT)

dds_al <- DESeqDataSetFromMatrix(countData = cts, colData = coldata2, design = ~ Gen_Time_and_treatment)
keepal <- rowSums(counts(dds_al)) >= ncol(cts)
dds_al <- dds_al[keepal,]
dds_al_out <- DESeq(dds_al)

# --- PE: Pre Early Heat (September 3, before any warming has occurred) ---
res_PE_C_E <- results(dds_al_out, contrast = c("Gen_Time_and_treatment", "PEE", "PEC"))
summary(res_PE_C_E)
res_PE_C_E <- filter(data.frame(res_PE_C_E))
res_PE_C_E_target <- filter(res_PE_C_E, padj < 0.05, abs(log2FoldChange) > 1)
res_PE_C_E_target$V3_gene_name = row.names(res_PE_C_E_target)

