############ PATHWAY ENRICHMENT
## ORA: You use your DE gene list, which already includes the p-value that you set to identify DE genes

list <- read.delim("list_genes_vitis_correspondencesV3_1.txt", header = TRUE)
Gene_function <- read.delim(file =  'Vitis_Net_gene_function.txt', header = T)
vitis_pathway <- gmtPathways("GSEA_geneset_from_VitisNet.gmt")

############################################ ENRICHMENT ANALYSIS FOR CONTROL VS BLF (Supp. Table 1) ###################################

# 1. Map DE genes to V1 gene names and functional annotations
res_DE <- res_E2_target  # your significant DE genes from C vs E

res_DE$V1_gene_name <- list$v1.name[match(res_DE$V3_gene_name,
                                          list$Final.v3.name..tentative.creation.of.new.genes)]
res_DE$encoding_protein <- Gene_function$Functional.annotation[match(res_DE$V1_gene_name,
                                                                     Gene_function$Unique.ID)]
res_DE$pathway <- Gene_function$Network[match(res_DE$V1_gene_name,
                                              Gene_function$Unique.ID)]

# Filter out genes with no pathway assignment
res_DE <- filter(res_DE, !is.na(pathway) & pathway != '')

n_func_DEGs <- nrow(res_DE)
n_func_DEGs

# 2. Define universe (all genes tested)
universe <- list$v1.name[match(rownames(res_E2), list$Final.v3.name..tentative.creation.of.new.genes)]
universe <- universe[!is.na(universe) & universe != '']

# 3. Over-Representation Analysis (ORA) for all DE genes
ORA_all <- fora(pathways = vitis_pathway,
                genes = res_DE$V1_gene_name,
                minSize = 2,
                maxSize = 500,
                universe = universe)

ORA_all$dir <- paste0('All DE genes (', nrow(res_DE), ')')

# 4. Filter for significant pathways
pathways_sig <- filter(ORA_all, padj < 0.05)
pathways_sig$poverlap <- (pathways_sig$overlap / pathways_sig$size) * 100
pathways_sig <- pathways_sig[order(-pathways_sig$poverlap), ]
pathways_sig$pathway <- factor(pathways_sig$pathway, levels = pathways_sig$pathway)

# 5. Separate up- and down-regulated genes for pathway enrichment (direction of regulation)
res_DE_up <- filter(res_DE, log2FoldChange > 0)
res_DE_down <- filter(res_DE, log2FoldChange < 0)

ORA_up <- fora(pathways = vitis_pathway, genes = res_DE_up$V1_gene_name,
               minSize = 2, maxSize = 500, universe = universe)
ORA_up$dir <- paste0("Upregulated in E vs C (", nrow(res_DE_up), ")")

ORA_down <- fora(pathways = vitis_pathway, genes = res_DE_down$V1_gene_name,
                 minSize = 2, maxSize = 500, universe = universe)
ORA_down$dir <- paste0("Downregulated in E vs C (", nrow(res_DE_down), ")")

